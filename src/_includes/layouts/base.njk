<!doctype html>
<html lang="{{ site.language | default('es') }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description | default(site.description) }}">
    <meta name="color-scheme" content="light dark">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="{{ site.title }}, inicio">{{ site.shortTitle }}<span aria-hidden="true">/</span></a>
        <nav aria-label="Navegación principal"><a href="/#programa">Programa</a><a href="/principios/">Principios</a></nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer"><div class="footer-inner"><p>{{ site.title }}</p><p>Material educativo abierto · 160 horas planificadas</p></div></footer>
  </body>
</html>
